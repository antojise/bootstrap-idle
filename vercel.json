{
  "headers": [
    {
      "source": "/(index.html)?",
      "headers": [{ "key": "Cache-Control", "value": "max-age=0, must-revalidate" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "max-age=0, must-revalidate" }]
    },
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "max-age=0, must-revalidate" }]
    },
    {
      "source": "/ui/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "max-age=0, must-revalidate" }]
    },
    {
      "source": "/src/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "max-age=0, must-revalidate" }]
    }
  ]
}
